# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- Database ----
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shopverse?retryWrites=true&w=majority
# Local:  mongodb://127.0.0.1:27017/shopverse
MONGO_URI=

# ---- Auth ----
# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=10
# Login/register attempts allowed per IP per 15 min (dev default 200, prod 20)
AUTH_RATE_LIMIT=200

# ---- CORS ----
# Must match the frontend origin EXACTLY (127.0.0.1 != localhost)
CLIENT_URL=http://127.0.0.1:5500

# ---- Business rules ----
LOW_STOCK_THRESHOLD=10
FREE_DELIVERY_ABOVE=500
DELIVERY_CHARGE=49
MAX_CART_QTY_PER_ITEM=10

# ---- Mock payment gateway ----
PAYMENT_MODE=mock
PAYMENT_SUCCESS_RATE=100

# ---- Seed admin (used once by: npm run seed) ----
ADMIN_EMAIL=admin@shopverse.com
ADMIN_PASSWORD=Admin@12345
